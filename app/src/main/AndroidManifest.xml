<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Read active SIM/subscription info so incoming SMS can be routed per SIM. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Keep the process alive long enough to finish the webhook POST while the
         device is in Doze (screen off, stationary). Without this the process is
         frozen the moment onReceive returns and the fire-and-forget POST is lost. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".SmsForwarderApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SMSForwarder">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SMSForwarder">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".DebugSmsReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.dealright.smsforwarder.DEBUG_SMS" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
